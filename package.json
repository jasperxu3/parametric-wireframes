{
  "name": "parametric-wireframes",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic parametric engineering wireframes and a Codex skill.",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/test.cjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "gallery": "node scripts/build-template-gallery.cjs --catalog assets/template-library/catalog.json --out docs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@gsap/react": "latest",
    "@tabler/icons-react": "latest",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "baseui": "latest",
    "dialkit": "latest",
    "gsap": "latest",
    "motion": "latest",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
