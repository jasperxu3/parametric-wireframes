#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  local started_at=$SECONDS
  printf '[setup] %s\n' "$label"
  "$@"
  printf '[setup] %s completed in %ss\n' "$label" "$((SECONDS - started_at))"
}

missing_packages=()
command -v node >/dev/null 2>&1 || missing_packages+=(nodejs)
command -v npm >/dev/null 2>&1 || missing_packages+=(npm)

if ((${#missing_packages[@]})); then
  if ((EUID == 0)); then
    step 'Update apt package metadata' apt-get update
    step 'Install Node.js and npm' apt-get install -y "${missing_packages[@]}"
  else
    step 'Update apt package metadata' sudo apt-get update
    step 'Install Node.js and npm' sudo apt-get install -y "${missing_packages[@]}"
  fi
fi

node_supported="$(node -p 'const [major, minor] = process.versions.node.split(".").map(Number); Number(major > 22 || (major === 22 && minor >= 12))')"
if ((node_supported != 1)); then
  printf '[setup] Node.js 22.12 or newer is required; found %s\n' "$(node --version)" >&2
  exit 1
fi

if ! command -v pnpm >/dev/null 2>&1; then
  step 'Install pnpm 11.1.3' npm install --global pnpm@11.1.3
fi

printf '[setup] Using Node.js %s and pnpm %s\n' "$(node --version)" "$(pnpm --version)"
step 'Install locked pnpm dependencies' pnpm install --frozen-lockfile
step 'Generate TanStack routes' pnpm generate-routes
step 'Verify sharp native module' node -e "require('sharp'); process.stdout.write('[setup] sharp loaded successfully\\n')"

if command -v amp >/dev/null 2>&1; then
  step 'Ensure Amp web service' amp orb services ensure
fi

printf '[setup] Orb setup complete\n'
