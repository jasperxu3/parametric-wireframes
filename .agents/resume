#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

command -v node >/dev/null 2>&1 || {
  printf '[resume] Node.js is missing; run .agents/setup\n' >&2
  exit 1
}

command -v pnpm >/dev/null 2>&1 || {
  printf '[resume] pnpm is missing; run .agents/setup\n' >&2
  exit 1
}

node -e "require('sharp')" 2>/dev/null || {
  printf '[resume] pnpm dependencies are missing or invalid; run .agents/setup\n' >&2
  exit 1
}

if command -v amp >/dev/null 2>&1; then
  amp orb services ensure
fi

printf '[resume] Node.js %s and pnpm dependencies are ready\n' "$(node --version)"
